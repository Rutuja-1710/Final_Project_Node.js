{
  "info": {
    "name": "Factory Equipment Maintenance API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register supervisor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara Supervisor\",\n  \"email\": \"sara@plant.com\",\n  \"password\": \"secret123\",\n  \"role\": \"supervisor\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);",
                  "pm.collectionVariables.set('supervisorToken', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register technician",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tom Technician\",\n  \"email\": \"tom@plant.com\",\n  \"password\": \"secret123\",\n  \"role\": \"technician\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('technicianToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (uses current token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sara@plant.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "Create equipment (supervisor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment"
              ]
            },
            "description": "Run 'Register supervisor' first so {{token}} is a supervisor token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hydraulic Press #1\",\n  \"location\": \"Bay 2\",\n  \"serviceIntervalDays\": 30\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('equipmentId', pm.response.json()._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List equipment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/equipment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get one equipment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/equipment/{{equipmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "{{equipmentId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Overdue equipment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/equipment/overdue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "overdue"
              ]
            },
            "description": "Newly created machines that were never serviced become overdue once createdAt + interval has passed. To demo: PATCH the interval to 1 and wait, or edit lastServicedDate in Atlas.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update interval (supervisor only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipment/{{equipmentId}}/interval",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "{{equipmentId}}",
                "interval"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceIntervalDays\": 14\n}"
            }
          }
        },
        {
          "name": "Update interval as technician -> 403",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipment/{{equipmentId}}/interval",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "{{equipmentId}}",
                "interval"
              ]
            },
            "description": "Uses {{technicianToken}} (run \"Register technician\" first). Expect 403.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{technicianToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceIntervalDays\": 14\n}"
            }
          }
        },
        {
          "name": "Maintenance history for equipment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/equipment/{{equipmentId}}/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "{{equipmentId}}",
                "logs"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Maintenance logs",
      "item": [
        {
          "name": "Create log with photo",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "equipment",
                  "value": "{{equipmentId}}",
                  "type": "text"
                },
                {
                  "key": "type",
                  "value": "preventive",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Replaced hydraulic filter and topped up oil",
                  "type": "text"
                },
                {
                  "key": "performedOn",
                  "value": "2026-09-20",
                  "type": "text"
                },
                {
                  "key": "photo",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Create log without photo",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "equipment",
                  "value": "{{equipmentId}}",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Routine visual inspection, no issues",
                  "type": "text"
                },
                {
                  "key": "type",
                  "value": "inspection",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Create log - validation error (422)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "equipment",
                  "value": "not-an-id",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "hi",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "List logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logs?equipment={{equipmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ],
              "query": [
                {
                  "key": "equipment",
                  "value": "{{equipmentId}}"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "supervisorToken",
      "value": ""
    },
    {
      "key": "technicianToken",
      "value": ""
    },
    {
      "key": "equipmentId",
      "value": ""
    }
  ]
}